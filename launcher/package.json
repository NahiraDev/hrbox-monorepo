{
  "name": "@hrbox/launcher",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "../dist/index.js",
  "types": "../dist/index.d.ts",
  "scripts": {
    "dev": "vite --config ../vite.config.ts",
    "dev:debug": "vite -debug --config ../vite.config.ts",
    "dev:turbo": "vite --force --clearScreen false --config ../vite.config.ts",
    "build": "vite build --config ../vite.config.ts",
    "build:analyze": "VITE_ANALYZE=true vite build --config ../vite.config.ts",
    "build:prod": "NODE_ENV=production vite build --config ../vite.config.ts",
    "build:staging": "NODE_ENV=stagin vite build --config ../vite.config.ts",
    "build:profile": "vite build --profile --config ../vite.config.ts",
    "build:modern": "VITE_BUILD_TARGET=modern vite build --config ../vite.config.ts",
    "build:legacy": "VITE_BUILD_TARGET=legacy vite build --config ../vite.config.ts",
    "build:sourcemap": "VITE_SOURCEMAP=true vite build --config ../vite.config.ts",
    "preview": "vite preview --config ../vite.config.ts",
    "preview:prod": "vite build && vite preview --config ../vite.config.ts",
    "preview:analyze": "vite preview --open /bundle-analysis.html"
  }
}
