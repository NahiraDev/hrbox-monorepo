{
  "*.{ts,tsx}": [
    "eslint --fix --max-warnings 0",
    "prettier --write",
    "bash -c 'tsc --noEmit'"
  ],
  "*.{js,jsx}": [
    "eslint --fix --max-warnings 0",
    "prettier --write"
  ],
  "*.{json,md,mdx,yml,yaml}": [
    "prettier --write"
  ],
  "*.{css,scss,less,sass}": [
    "prettier --write"
  ],
  "*.{html,htm}": [
    "prettier --write"
  ],
  "package.json": [
    "prettier --write",
    "sort-package-json"
  ]
}
