{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "emitDeclarationOnly": true
  },
  "files": ["src/index.ts"],
  "include": [
    "src",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "declarations.d.ts",
    "global.d.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["dist"]
}
