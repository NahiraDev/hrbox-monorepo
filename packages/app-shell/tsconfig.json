{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "src",
    "src/**/*",
    "**/*.d.ts",
    "types/**/*.d.ts",
    "global.d.ts",
    "declarations.d.ts"
  ],
  "exclude": ["dist"],
  "references": [
    { "path": "../shared-navigations" },
    { "path": "../shared-translation" },
    { "path": "../shared-templates" },
    { "path": "../shared-styles" },
    { "path": "../shared-services" }
  ]
}
