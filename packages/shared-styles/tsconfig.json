{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "composite": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/tailwind.config.ts",
    "*.d.ts",
    "types/**/*.d.ts",
    "declarations.d.ts",
    "global.d.ts"
  ],
  "exclude": ["dist"]
}
