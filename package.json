{
  "name": "hrbox-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "description": "Next-generation HR management platform with micro-frontend architecture",
  "keywords": [
    "hr",
    "enterprise",
    "monorepo",
    "micro-frontend",
    "vite",
    "turbo"
  ],
  "author": "HRBox Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "clean": "rm -rf ./node_modules ./dist ./pnpm-lock.yaml ./.turbo ./.idea",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:main": "vite",
    "build:main": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint:staged": "lint-staged",
    "docker:build": "docker build -t hrbox-monorepo .",
    "docker:dev": "docker-compose up -d",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "analyze": "pnpm build && npx webpack-bundle-analyzer dist/stats.json",
    "security:audit": "pnpm audit",
    "dependency:check": "pnpm outdated",
    "clean:all": "rm -rf dist node_modules/.vite-cache .turbo node_modules",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --cache",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "build:analyze": "pnpm build && npx vite-bundle-analyzer dist/stats.json",
    "prepare": "husky install",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@eslint/compat": "^1.4.1",
    "@heroui/button": "^2.2.27",
    "@heroui/input": "^2.4.28",
    "@heroui/react": "^2.8.5",
    "@heroui/system": "^2.4.23",
    "@heroui/theme": "^2.4.23",
    "@heroui/use-theme": "^2.1.10",
    "@internationalized/date": "^3.10.0",
    "@module-federation/utilities": "^3.1.73",
    "@react-aria/visually-hidden": "3.8.28",
    "@react-types/shared": "3.32.1",
    "@reduxjs/toolkit": "^2.9.2",
    "@tailwindcss/vite": "4.1.16",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.9.2",
    "@xyflow/react": "^12.9.1",
    "apexcharts": "^5.3.5",
    "bpmn-js": "^18.8.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "clsx": "2.1.1",
    "comlink": "^4.4.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-object": "^2.1.6",
    "dotenv": "^17.2.3",
    "elkjs": "^0.11.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.1.0",
    "formik": "^2.4.6",
    "framer-motion": "12.23.24",
    "glob": "^11.0.3",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "i18n": "^0.15.2",
    "iconsax-react": "^0.0.8",
    "ky": "^1.13.0",
    "leaflet": "^1.9.4",
    "lottie-react": "^2.4.1",
    "morgan": "^1.10.1",
    "qs": "^6.14.0",
    "react": "19.2.0",
    "react-apexcharts": "^1.8.0",
    "react-chartjs-2": "^5.3.1",
    "react-circular-progressbar": "^2.2.0",
    "react-date-object": "^2.1.9",
    "react-datepicker": "^8.8.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.2.2",
    "react-modern-calendar-datepicker": "^3.1.6",
    "react-multi-date-picker": "^4.5.2",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.5",
    "reactflow": "^11.11.4",
    "svgo": "^4.0.0",
    "tailwind-variants": "3.1.1",
    "tsx": "^4.20.6",
    "ws": "^8.18.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@hrbox/core": "workspace:*",
    "@hrbox/proxy-server": "workspace:*",
    "@module-federation/vite": "^1.9.0",
    "@module/basic-info": "workspace:*",
    "@module/chart-maker": "workspace:*",
    "@module/hrlink": "workspace:*",
    "@module/process-maker": "workspace:*",
    "@module/sso": "workspace:*",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/core": "^1.14.0",
    "@swc/plugin-emotion": "^12.0.0",
    "@swc/plugin-styled-components": "^10.0.0",
    "@tailwindcss/postcss": "4.1.16",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/lodash-es": "^4.17.12",
    "@types/morgan": "^1.9.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitejs/plugin-react-swc": "^4.2.0",
    "autoprefixer": "^10.4.21",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.11",
    "eslint": "^9.38.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "i18next": "^25.6.0",
    "imagemin-webp": "^8.0.0",
    "lightningcss": "^1.30.2",
    "lint-staged": "^16.2.6",
    "minimatch": "^10.1.1",
    "moment-jalaali": "^0.10.4",
    "patch-package": "^8.0.1",
    "postcss": "8.5.6",
    "postcss-custom-properties": "^14.0.6",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "react-leaflet": "5.0.0",
    "react-router-dom": "7.9.5",
    "redux-persist": "^6.0.0",
    "rollup": "^4.52.5",
    "sort-package-json": "^3.4.0",
    "swiper": "^12.0.3",
    "tailwindcss": "^4.1.16",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "tsx": "^4.20.3",
    "turbo": "^2.5.8",
    "typescript": "5.9.3",
    "vite": "^7.1.12",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-bundle-analyzer": "^0.0.1",
    "vite-plugin-checker": "^0.11.0",
    "vite-plugin-comlink": "^5.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-ejs": "^1.7.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-minify": "^2.1.0",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-static-copy": "^3.1.4",
    "vite-plugin-webfont-dl": "^3.11.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{css,scss,less}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "modules/*",
    "core",
    "launcher",
    "proxy-server"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "chrome >= 87",
      "firefox >= 78",
      "safari >= 14",
      "edge >= 88"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "bundlesize": [
    {
      "path": "./dist/core/index.js",
      "maxSize": "500kb",
      "compression": "gzip"
    },
    {
      "path": "./dist/modules/*/index.js",
      "maxSize": "500kb",
      "compression": "gzip"
    },
    {
      "path": "./dist/index.js",
      "maxSize": "1000kb",
      "compression": "gzip"
    }
  ],
  "volta": {
    "node": "20.19.1",
    "pnpm": "10.17.1"
  }
}
