  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{css,scss,less}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "modules/*",
    "core/*",
    "launcher/*"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "chrome >= 87",
      "firefox >= 78",
      "safari >= 14",
      "edge >= 88"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "bundlesize": [
    {
      "path": "./dist/core/index.js",
      "maxSize": "500kb",
      "compression": "gzip"
    },
    {
      "path": "./dist/modules/*/index.js",
      "maxSize": "500kb",
      "compression": "gzip"
    },
    {
      "path": "./dist/index.js",
      "maxSize": "1000kb",
      "compression": "gzip"
    }
  ],
  "volta": {
    "node": "20.19.1",
    "pnpm": "10.17.1"
  }
}
