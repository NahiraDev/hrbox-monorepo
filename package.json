{
  "name": "hrbox-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "description": "Next-generation HR management platform with micro-frontend architecture",
  "keywords": [
    "hr",
    "enterprise",
    "monorepo",
    "micro-frontend",
    "vite",
    "turbo"
  ],
  "author": "HRBox Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "clean": "rm -rf ./node_modules ./dist ./pnpm-lock.yaml ./.turbo ./.idea",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:main": "vite",
    "build:main": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint:staged": "lint-staged",
    "validate": "npm run lint && npm run type-check && npm run test:ci && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "chromatic": "chromatic --project-token=your-token",
    "docker:build": "docker build -t hrbox-monorepo .",
    "docker:dev": "docker-compose up -d",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "analyze": "pnpm build && npx webpack-bundle-analyzer dist/stats.json",
    "security:audit": "pnpm audit",
    "dependency:check": "pnpm outdated",
    "clean:all": "rm -rf dist node_modules/.vite-cache .turbo node_modules",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --cache",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "build:analyze": "pnpm build && npx vite-bundle-analyzer dist/stats.json",
    "prepare": "husky install",
    "postinstall": "patch-package"
  },
