{
  "name": "hrbox-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "description": "Next-generation HR management platform with micro-frontend architecture",
  "keywords": [
    "hr",
    "enterprise",
    "monorepo",
    "micro-frontend",
    "vite",
    "turbo"
  ],
  "author": "HRBox Team",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf ./node_modules ./dist ./pnpm-lock.yaml ./.turbo ./.idea",
    "build": "turbo run build",
    "dev": "turbo run dev & node scripts/mockWebSocketServer.js",
    "dev:main": "turbo run dev --config vite.config.ts --port 4173",
    "dev:modules": "turbo run dev --parallel --filter=@module/*",
    "dev:all": "turbo run dev:main dev --parallel",
    "dev:hrlink": "pnpm --filter @module/hrlink dev",
    "dev:basic-info": "pnpm --filter @module/basic-info dev",
    "dev:chart-maker": "pnpm --filter @module/chart-maker dev",
    "dev:process-maker": "pnpm --filter @module/process-maker dev",
    "dev:project-management": "pnpm --filter @module/project-management dev",
    "predev": "node ./scripts/i18n-sync.mjs",
    "dev:sso": "pnpm --filter @module/sso dev",
    "dev:parallel": "turbo run dev --parallel",
    "build:main": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint:staged": "lint-staged",
    "docker:build": "docker build -t hrbox-monorepo .",
    "docker:dev": "docker-compose up -d",
    "security:audit": "pnpm audit",
    "dependency:check": "pnpm outdated",
    "clean:all": "rm -rf dist node_modules/.vite-cache .turbo node_modules",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --cache",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "start": "node scripts/mockWebSocketServer.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
