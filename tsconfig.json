{
  "extends": "./configs/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@core/*": ["core/*"],
      "@module/*": ["modules/*"],
      "@configs/*": ["configs/*"],
      "@mock/*": ["mock/*"]
    },
    "typeRoots": ["./node_modules/@types", "./types"],
    "types": ["vite/client"]
  },
  "include": [
    "core/**/*",
    "modules/**/*",
    "configs/**/*",
    "mock/**/*",
    "**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "**/dist"]
}
