{
  "extends": "./configs/tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "core/*": ["core/*"],
      "@module/*": ["modules/*"],
      "@configs/*": ["configs/*"],
      "@mock/*": ["mock/*"],
    },
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["core", "modules", "configs", "mock"],
  "exclude": ["node_modules", "dist"]
}
