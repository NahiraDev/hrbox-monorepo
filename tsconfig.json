{
  "extends": "./configs/tsconfig.base.json",
  "compilerOptions":{
    "baseUrl": ".",
    "paths": {
      "@core/*": ["core/*"],
      "@module/*": ["modules/*"],
      "@configs/*": ["configs/*"]
    },
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["core" , "modules" , "configs"],
  "exclude": ["node_modules", "dist"]
}
