{
  "compilerOptions": {
    "target": "ES2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "preserveConstEnums": true,
    "useDefineForClassFields": true,
    "jsxImportSource": "react",
    "sourceMap": true,
    "composite": true,
    "baseUrl": "./",
    "paths": {
      "@core/*": ["core/*"],
      "@module/*": ["modules/*"],
      "@configs/*": ["configs/*"],
      "@mock/*": ["mock/*"]
    },
    "typeRoots": ["./node_modules/@types", "./types" , "vite/client", "vitest/globals", "@testing-library/jest-dom"],
  },
  "include": [
    "core/**/*",
    "modules/**/*",
    "configs/**/*",
    "mock/**/*",
    "launcher/**/*",
    "*.ts",
    "*.tsx",
  ],
  "references": [
    { "path": "core/tsconfig.json" },
    { "path": "launcher/tsconfig.json" },
    { "path": "modules/hrlink/tsconfig.json" },
    { "path": "modules/sso/tsconfig.json" },
    { "path": "modules/process-maker/tsconfig.json" },
    { "path": "modules/basic-info/tsconfig.json" },
    { "path": "modules/chart-maker/tsconfig.json" }
  ],
  "exclude": ["node_modules", "dist", "build", "declarations.d.ts" , ".turbo"]
}
