{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "modules/**/*.{ts,tsx,js,jsx}",
        "core/**/*.{ts,tsx,js,jsx}",
        "package.json",
        "tsconfig.json",
        "vite.config.ts"
      ],
      "outputs": [
        "dist/**"
      ],
      "persistent": false,
      "cache": false,
      "env": [
        "VITE_ENABLED_MODULES"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^dev"
      ]
    },
    "lint": {
      "inputs": [
        "modules/**/*.{ts,tsx,js,jsx}",
        "core/**/*.{ts,tsx,js,jsx}",
        "eslint.config.js",
        "tsconfig.json"
      ],
      "outputs": [],
      "cache": true
    },
    "type-check": {
      "dependsOn": [],
      "inputs": [
        "modules/**/*.{ts,tsx,js,jsx}",
        "core/**/*.{ts,tsx,js,jsx}",
        "tsconfig.json"
      ],
      "outputs": [],
      "cache": true
    },
    "test": {
      "dependsOn": [],
      "inputs": [
        "modules/**/*.{ts,tsx,js,jsx}",
        "core/**/*.{ts,tsx,js,jsx}",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}"
      ],
      "outputs": [
        "coverage/**"
      ],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "VITE_ENABLED_MODULES"
  ],
  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "turbo.json",
    "tsconfig.json",
    ".env*"
  ]
}
