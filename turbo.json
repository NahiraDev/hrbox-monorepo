{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "PORT"]
    },
    "dev:standalone": {
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "clean": {
      "dependsOn": ["^dist", "^node_modules", "^.turbo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "outputs": [],
      "cache": true
    }
  }
}
